{
  "trailingSlash": true,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/design-system.css",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/pages.css",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/main.js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/logo.svg",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)\\.(webp|png|jpg|jpeg|gif|avif|woff|woff2|ttf|otf)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(analytics|intake-form|theme).js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "rewrites": [
    { "source": "/blog", "destination": "/blog/index.html" }
  ],
  "redirects": [
    { "source": "/blog.html", "destination": "/blog/", "permanent": true },
    { "source": "/blog-detail.html", "destination": "/blog/", "permanent": true },
    { "source": "/about-designit", "destination": "/about/", "permanent": true },
    { "source": "/about-designit/", "destination": "/about/", "permanent": true },
    { "source": "/about-designit.html", "destination": "/about/", "permanent": true },

    { "source": "/projects/rcentric/ela/orla-infinity.html", "destination": "/projects/rcentric/orla-infinity/", "permanent": true },
    { "source": "/projects/rcentric/ela/orla-infinity", "destination": "/projects/rcentric/orla-infinity/", "permanent": true },
    { "source": "/projects/adda247/studio-app/my-content.html", "destination": "/projects/adda247/my-content/", "permanent": true },
    { "source": "/projects/adda247/studio-app/my-content", "destination": "/projects/adda247/my-content/", "permanent": true },
    { "source": "/projects/adda247/my-content/studio-app.html", "destination": "/projects/adda247/studio-app/", "permanent": true },
    { "source": "/projects/adda247/my-content/studio-app", "destination": "/projects/adda247/studio-app/", "permanent": true },
    { "source": "/projects/rcentric/opus/ela.html", "destination": "/projects/rcentric/ela/", "permanent": true },
    { "source": "/projects/rcentric/opus/ela", "destination": "/projects/rcentric/ela/", "permanent": true }
  ]
}
