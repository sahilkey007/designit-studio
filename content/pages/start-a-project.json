    {
      "type": "html",
      "id": "project-form",
      "html": "<div class=\"sp-wrap\"><div class=\"sp-head\"><p id=\"spProgress\" class=\"sp-progress\">Step 1 of 10</p><div class=\"sp-track\" aria-hidden=\"true\"><div class=\"sp-bar\" id=\"spBar\"></div></div></div><form id=\"spForm\" class=\"sp-form\" novalidate><input type=\"hidden\" name=\"recommendation\" value=\"\"><fieldset class=\"sp-step\" data-required=\"radio\"><legend>What are you trying to achieve?</legend><div class=\"sp-options\"><label class=\"sp-opt\"><input type=\"radio\" name=\"goal\" value=\"launch\"><span>Launch something new</span></label><label class=\"sp-opt\"><input type=\"radio\" name=\"goal\" value=\"fix\"><span>Fix a product that's hard to use</span></label><label class=\"sp-opt\"><input type=\"radio\" name=\"goal\" value=\"conversion\"><span>Improve activation or conversion</span></label><label class=\"sp-opt\"><input type=\"radio\" name=\"goal\" value=\"modernise\"><span>Modernise a legacy product</span></label><label class=\"sp-opt\"><input type=\"radio\" name=\"goal\" value=\"scale\"><span>Scale design across products or teams</span></label><label class=\"sp-opt\"><input type=\"radio\" name=\"goal\" value=\"ai\"><span>Design an AI feature or agent</span></label><label class=\"sp-opt\"><input type=\"radio\" name=\"goal\" value=\"website\"><span>Redesign our website</span></label><label class=\"sp-opt\"><input type=\"radio\" name=\"goal\" value=\"brand\"><span>Build or refresh our brand</span></label></div><p class=\"sp-error\" role=\"alert\"></p></fieldset><fieldset class=\"sp-step\" data-required=\"radio\"><legend>What are you working on?</legend><div class=\"sp-options\"><label class=\"sp-opt\"><input type=\"radio\" name=\"what\" value=\"saas\"><span>B2B SaaS or software platform</span></label><label class=\"sp-opt\"><input type=\"radio\" name=\"what\" value=\"mobile\"><span>Mobile app</span></label><label class=\"sp-opt\"><input type=\"radio\" name=\"what\" value=\"website\"><span>Website</span></label><label class=\"sp-opt\"><input type=\"radio\" name=\"what\" value=\"ai\"><span>AI product or feature</span></label><label class=\"sp-opt\"><input type=\"radio\" name=\"what\" value=\"enterprise\"><span>Internal or enterprise tool</span></label><label class=\"sp-opt\"><input type=\"radio\" name=\"what\" value=\"other\"><span>Something else</span></label></div><p class=\"sp-error\" role=\"alert\"></p></fieldset><fieldset class=\"sp-step\" data-required=\"radio\"><legend>What stage are you at?</legend><div class=\"sp-options\"><label class=\"sp-opt\"><input type=\"radio\" name=\"stage\" value=\"idea\"><span>Idea or pre-build</span></label><label class=\"sp-opt\"><input type=\"radio\" name=\"stage\" value=\"mvp\"><span>MVP or first users</span></label><label class=\"sp-opt\"><input type=\"radio\" name=\"stage\" value=\"growing\"><span>Growing product</span></label><label class=\"sp-opt\"><input type=\"radio\" name=\"stage\" value=\"mature\"><span>Mature or enterprise product</span></label></div><p class=\"sp-error\" role=\"alert\"></p></fieldset><fieldset class=\"sp-step\" data-required=\"check\"><legend>What isn't working?</legend><p class=\"sp-hint\">Choose all that apply.</p><div class=\"sp-options\"><label class=\"sp-opt\"><input type=\"checkbox\" name=\"pain\" value=\"onboarding\"><span>Users drop off during onboarding</span></label><label class=\"sp-opt\"><input type=\"checkbox\" name=\"pain\" value=\"findability\"><span>People can't find features</span></label><label class=\"sp-opt\"><input type=\"checkbox\" name=\"pain\" value=\"conversion\"><span>Low conversion</span></label><label class=\"sp-opt\"><input type=\"checkbox\" name=\"pain\" value=\"inconsistent\"><span>Inconsistent UI across the product</span></label><label class=\"sp-opt\"><input type=\"checkbox\" name=\"pain\" value=\"slow\"><span>Design is slowing delivery</span></label><label class=\"sp-opt\"><input type=\"checkbox\" name=\"pain\" value=\"ai-trust\"><span>Users don't trust or use the AI</span></label><label class=\"sp-opt\"><input type=\"checkbox\" name=\"pain\" value=\"website-clarity\"><span>Our website doesn't explain us</span></label><label class=\"sp-opt\"><input type=\"checkbox\" name=\"pain\" value=\"brand\"><span>Our brand looks dated or unclear</span></label><label class=\"sp-opt\"><input type=\"checkbox\" name=\"pain\" value=\"unsure\"><span>Not sure yet</span></label></div><p class=\"sp-error\" role=\"alert\"></p></fieldset><fieldset class=\"sp-step\" data-required=\"check\"><legend>What do you think you need?</legend><p class=\"sp-hint\">Choose all that apply.</p><div class=\"sp-options\"><label class=\"sp-opt\"><input type=\"checkbox\" name=\"need\" value=\"research\"><span>User research</span></label><label class=\"sp-opt\"><input type=\"checkbox\" name=\"need\" value=\"audit\"><span>A UX audit or review</span></label><label class=\"sp-opt\"><input type=\"checkbox\" name=\"need\" value=\"design\"><span>UX/UI design</span></label><label class=\"sp-opt\"><input type=\"checkbox\" name=\"need\" value=\"system\"><span>A design system</span></label><label class=\"sp-opt\"><input type=\"checkbox\" name=\"need\" value=\"prototype\"><span>A prototype to test</span></label><label class=\"sp-opt\"><input type=\"checkbox\" name=\"need\" value=\"support\"><span>Implementation support</span></label><label class=\"sp-opt\"><input type=\"checkbox\" name=\"need\" value=\"branding\"><span>Branding</span></label><label class=\"sp-opt\"><input type=\"checkbox\" name=\"need\" value=\"unsure\"><span>Not sure, advise us</span></label></div><p class=\"sp-error\" role=\"alert\"></p></fieldset><fieldset class=\"sp-step\" data-required=\"radio\"><legend>How big is your team?</legend><div class=\"sp-options\"><label class=\"sp-opt\"><input type=\"radio\" name=\"team\" value=\"1-2\"><span>Just the founders</span></label><label class=\"sp-opt\"><input type=\"radio\" name=\"team\" value=\"2-10\"><span>2 to 10 people</span></label><label class=\"sp-opt\"><input type=\"radio\" name=\"team\" value=\"11-50\"><span>11 to 50</span></label><label class=\"sp-opt\"><input type=\"radio\" name=\"team\" value=\"51-200\"><span>51 to 200</span></label><label class=\"sp-opt\"><input type=\"radio\" name=\"team\" value=\"200+\"><span>More than 200</span></label></div><p class=\"sp-error\" role=\"alert\"></p></fieldset><fieldset class=\"sp-step\" data-required=\"radio\"><legend>What's your timeline?</legend><div class=\"sp-options\"><label class=\"sp-opt\"><input type=\"radio\" name=\"timeline\" value=\"ASAP\"><span>As soon as possible</span></label><label class=\"sp-opt\"><input type=\"radio\" name=\"timeline\" value=\"Within a month\"><span>Within a month</span></label><label class=\"sp-opt\"><input type=\"radio\" name=\"timeline\" value=\"1-3 months\"><span>In 1 to 3 months</span></label><label class=\"sp-opt\"><input type=\"radio\" name=\"timeline\" value=\"Exploring\"><span>Just exploring</span></label></div><p class=\"sp-error\" role=\"alert\"></p></fieldset><fieldset class=\"sp-step\"><legend>Do you have a budget band in mind? (optional)</legend><p class=\"sp-hint\">Optional. It only helps us suggest the right scope.</p><div class=\"sp-options\"><label class=\"sp-opt\"><input type=\"radio\" name=\"budget\" value=\"₹50K–₹1L\"><span>₹50K to ₹1L</span></label><label class=\"sp-opt\"><input type=\"radio\" name=\"budget\" value=\"₹1L–₹2L\"><span>₹1L to ₹2L</span></label><label class=\"sp-opt\"><input type=\"radio\" name=\"budget\" value=\"₹2L–₹5L\"><span>₹2L to ₹5L</span></label><label class=\"sp-opt\"><input type=\"radio\" name=\"budget\" value=\"₹5L+\"><span>₹5L or more</span></label><label class=\"sp-opt\"><input type=\"radio\" name=\"budget\" value=\"Not sure\"><span>Not sure yet</span></label></div><p class=\"sp-error\" role=\"alert\"></p></fieldset><fieldset class=\"sp-step\"><legend>Your company</legend><div class=\"sp-rec\" aria-live=\"polite\"><p class=\"sp-rec-k\">Based on your answers, we would suggest starting with</p><p class=\"sp-rec-name\" id=\"spRecName\"></p><p class=\"sp-rec-why\" id=\"spRecWhy\"></p><a id=\"spRecLink\" class=\"sp-rec-link\" href=\"/services/\">Read more</a></div><div class=\"sp-fields\"><label>Company name<input type=\"text\" name=\"company\" autocomplete=\"organization\"></label><label>Website<input type=\"url\" name=\"website\" autocomplete=\"url\" placeholder=\"https://\"></label></div><p class=\"sp-error\" role=\"alert\"></p></fieldset><fieldset class=\"sp-step\" data-required=\"contact\"><legend>How do we reach you?</legend><div class=\"sp-fields\"><label>Your name<input type=\"text\" name=\"fullName\" autocomplete=\"name\" required></label><label>Work email<input type=\"email\" name=\"email\" autocomplete=\"email\" required></label><label>Phone (optional)<input type=\"tel\" name=\"phone\" autocomplete=\"tel\"></label><label class=\"sp-wide\">Anything else we should know? (optional)<textarea name=\"notes\" rows=\"4\"></textarea></label></div><p class=\"sp-note\">We reply within one working day. Your details are used only to respond to this enquiry; see our <a href=\"/privacy-policy/\">privacy policy</a>.</p><p class=\"sp-error\" role=\"alert\"></p></fieldset><div class=\"sp-actions\"><button type=\"button\" class=\"btn btn-outline btn-md\" id=\"spBack\" hidden>Back</button><button type=\"button\" class=\"btn btn-primary btn-md\" id=\"spNext\">Next</button></div></form><div id=\"spDone\" class=\"sp-done\" hidden><h2 class=\"pg-h2\">Thank you, we have your details</h2><p class=\"pg-intro\">We will reply within one working day. Based on your answers, we suggested starting with <strong id=\"spDoneRec\"></strong>. If it is urgent, email <a href=\"mailto:contact@designit.co.in\">contact@designit.co.in</a>.</p></div><p id=\"spStatus\" class=\"sr-only\" role=\"status\" aria-live=\"polite\"></p><noscript><p class=\"pg-intro\">This form needs JavaScript. Email <a href=\"mailto:contact@designit.co.in\">contact@designit.co.in</a> instead and we will reply within one working day.</p></noscript></div>"
    }
  ],
  "faq": [
    {
      "q": "What happens after I send this?",
      "a": "We read your answers and reply within one working day, usually suggesting a 30-minute call. You will not get an automated sales sequence."
    },
    {
      "q": "Do I need to know which service I need?",
      "a": "No. The questions are about your situation, not our services. The recommendation is a starting point we can discuss."
    },
    {
      "q": "Is the budget question required?",
      "a": "No. It only helps us suggest a scope that fits."
    },
    {
      "q": "Would you rather talk first?",
      "a": "Email <a href=\"mailto:contact@designit.co.in\">contact@designit.co.in</a> or call +91 8564948954."
    }
  ]
}