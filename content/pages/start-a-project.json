  "css": ".sp-wrap{max-width:760px;margin:0 auto}.sp-head{margin:0 0 24px}.sp-progress{font-size:14px;color:var(--text-tertiary);margin:0 0 10px;text-align:center}.sp-track{height:4px;background:var(--bg-surface);border-radius:4px;overflow:hidden}.sp-bar{height:100%;width:10%;background:#fff;transition:width .3s}.sp-step{border:0;margin:0;padding:0}.sp-step legend{font-size:clamp(24px,3.4vw,34px);font-weight:700;color:#fff;letter-spacing:-.6px;line-height:1.2;margin:0 0 8px;outline:none}.sp-hint{color:var(--text-tertiary);font-size:15px;margin:0 0 4px}.sp-options{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:12px;margin-top:20px}.sp-opt{position:relative;display:flex;align-items:center;gap:12px;padding:16px 18px;background:var(--bg-card);border:1px solid var(--border-default);border-radius:var(--radius-md);cursor:pointer;color:#ddd;font-size:16px;line-height:1.4}.sp-opt:hover{border-color:var(--border-medium)}.sp-opt input{width:18px;height:18px;accent-color:#fff;flex:0 0 18px;margin:0}.sp-opt:has(input:checked){border-color:#fff;background:var(--bg-surface)}.sp-opt input:focus-visible{outline:2px solid #fff;outline-offset:3px}.sp-fields{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:20px}.sp-fields label{display:flex;flex-direction:column;gap:8px;font-size:14px;font-weight:500;color:#ddd}.sp-fields .sp-wide{grid-column:1/-1}.sp-fields input,.sp-fields textarea{font:inherit;font-size:16px;color:#fff;background:var(--bg-card);border:1px solid var(--border-default);border-radius:var(--radius-sm);padding:12px 14px}.sp-fields input:focus,.sp-fields textarea:focus{outline:2px solid #fff;outline-offset:1px}.sp-error{min-height:22px;color:#ff8a8a;font-size:14px;margin:12px 0 0}.sp-actions{display:flex;justify-content:space-between;gap:12px;margin-top:28px}.sp-actions #spNext{margin-left:auto;min-width:140px}.sp-rec{margin:16px 0 4px;padding:20px 22px;border:1px solid var(--border-default);border-left:3px solid #fff;border-radius:var(--radius-md);background:var(--bg-card)}.sp-rec-k{font-size:13px;color:var(--text-tertiary);margin:0}.sp-rec-name{font-size:22px;font-weight:700;color:#fff;margin:4px 0 6px}.sp-rec-why{font-size:15px;color:var(--text-tertiary);line-height:1.6;margin:0 0 8px}.sp-rec-link{font-size:14px;font-weight:600;color:#fff;text-decoration:underline;text-underline-offset:3px}.sp-note{font-size:13px;color:var(--text-tertiary);margin:14px 0 0}.sp-note a{color:#ddd;text-decoration:underline}.sp-done{text-align:center;padding:24px 0}@media (max-width:640px){.sp-fields{grid-template-columns:1fr}.sp-options{grid-template-columns:1fr}}.sp-actions [hidden],.sp-step[hidden],.sp-done[hidden],.sp-form[hidden]{display:none!important}",
